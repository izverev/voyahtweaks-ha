{
  "config": {
    "step": {
      "user": {
        "title": "Sign in to Voyahtweaks",
        "description": "Enter your app.voyahtweaks.ru username and password. The VIN is detected automatically.",
        "data": {
          "username": "Username",
          "password": "Password"
        }
      },
      "verify": {
        "title": "Confirm your email",
        "description": "A code was sent to {email}. Enter it below. To get a new code, tick “Resend code” and submit.",
        "data": {
          "code": "Code from the email",
          "resend": "Resend code"
        }
      },
      "vehicle": {
        "title": "Choose a vehicle",
        "description": "Your profile has several vehicles. Pick one.",
        "data": {
          "vin": "Vehicle"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate",
        "description": "The session for {username} expired. Enter the password again.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid username or password",
      "cannot_connect": "Cannot connect to Voyahtweaks",
      "invalid_code": "Invalid or expired code",
      "resend_failed": "Could not resend the code. Try again later.",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This vehicle is already configured",
      "no_vehicles": "No enabled vehicles in the profile",
      "invalid_auth": "Authentication failed",
      "cannot_connect": "Cannot connect to Voyahtweaks",
      "unknown": "Unexpected error",
      "reauth_successful": "Re-authentication successful"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "VoyahTweaks options",
        "description": "The API is never polled more than once per minute.",
        "data": {
          "scan_interval_min": "Polling interval",
          "stale_after_min": "Treat data as stale after (min)",
          "detailed_diagnostics": "Detailed battery diagnostics",
          "cell_sensors": "Individual cell sensors (up to 99)",
          "enable_commands": "Allow vehicle control (locks, windows, climate, charging…)",
          "enable_dangerous_commands": "Allow keyless start (requires vehicle control)"
        },
        "data_description": {
          "enable_commands": "Commands are really sent to the vehicle. Enable only if you trust every user of this Home Assistant.",
          "enable_dangerous_commands": "Adds a button that can start the vehicle."
        }
      }
    }
  },
  "exceptions": {
    "commands_disabled": {
      "message": "Vehicle control is disabled. Enable it in the integration options."
    },
    "dangerous_disabled": {
      "message": "This command can start the vehicle and is disabled. Enable it separately in the integration options."
    },
    "command_auth": {
      "message": "The Voyahtweaks session is no longer valid; re-authentication is required."
    },
    "command_timeout": {
      "message": "The vehicle did not confirm the command in time (last status: {status}). It may still be executed later."
    },
    "command_error": {
      "message": "The server rejected the command: {reason} (HTTP {status})."
    },
    "command_failed": {
      "message": "Command failed: {reason}"
    },
    "command_no_response": {
      "message": "The vehicle did not confirm the command."
    },
    "command_expired": {
      "message": "The command was not delivered (expired)."
    }
  },
  "services": {
    "climate_start": {
      "name": "Start climate",
      "description": "Starts the climate with the options supported by the Voyahtweaks app.",
      "fields": {
        "mode": {
          "name": "Mode",
          "description": "temp keeps a target temperature; rapid_cool / rapid_heat cool or heat quickly."
        },
        "temperature": {
          "name": "Temperature",
          "description": "Only for mode temp."
        },
        "seat_fl": {
          "name": "Driver seat",
          "description": "-3 (ventilation) to 3 (heating), 0 is off."
        },
        "seat_fr": {
          "name": "Passenger seat",
          "description": "-3 (ventilation) to 3 (heating), 0 is off."
        },
        "glass_heat": {
          "name": "Windshield heating",
          "description": "Heating modes only."
        },
        "runtime": {
          "name": "Run time",
          "description": "Minutes."
        }
      }
    },
    "charge_start": {
      "name": "Start charging",
      "description": "Starts charging now up to the given level.",
